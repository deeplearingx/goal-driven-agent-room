# Copy to .env (which is gitignored) and fill in the blanks.
# Never commit real secrets to .env.example.

# --- Pick ONE provider path ---

# Path A: native Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Path B: Anthropic-compatible gateway (e.g. Volcano Engine Ark, OpenRouter, ...)
# Used when the gateway speaks the Anthropic Messages API but isn't api.anthropic.com.
# ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# ANTHROPIC_AUTH_TOKEN=<your-gateway-token>
# ANTHROPIC_MODEL=<gateway-side-model-name>

# Path C: OpenAI
# OPENAI_API_KEY=sk-...

# --- Model bindings (optional, fall back to AGENT_ROOM_DEFAULT_MODEL) ---
AGENT_ROOM_DEFAULT_MODEL=claude-sonnet-4-6
# AGENT_ROOM_PLANNER_MODEL=
# AGENT_ROOM_DEVELOPER_MODEL=
# AGENT_ROOM_REVIEWER_MODEL=
# AGENT_ROOM_DELIVERY_MODEL=

# --- Persistence + server ---
AGENT_ROOM_DB=./agent_room.db
AGENT_ROOM_HOST=127.0.0.1
AGENT_ROOM_PORT=8765

# --- Tool-using developer (ReAct) — see SECURITY.md ---
# Default server graph. `full_react` gives the developer sandboxed tools (so the
# pixel UI's tool badges light up); `full` = tool-less developer.
# `goal` = goal mode (PLAN.md goal-mode section): keeps iterating
# developer→verify until the task's `verify_command` exits 0 (or the reviewer
# approves, when no command is given); every STUCK_EVERY consecutive failures
# a supervisor makes one strategy call (continue/replan/ask_user/abort).
# Set verify_command / verify_files / max_iterations in the POST /tasks body.
AGENT_ROOM_GRAPH=full_react
# Sandbox root for fs tools + shell cwd. Use a throwaway dir — the developer may
# overwrite files inside it.
AGENT_ROOM_WORKSPACE=./workspace
# Comma-separated shell allowlist (head token). Empty string disables shell.
AGENT_ROOM_SHELL_ALLOWLIST=pytest,python,python3,ruff
# unrestricted | approval (per-call human gate) | read_only
AGENT_ROOM_TOOL_MODE=unrestricted

# SSE heartbeat: seconds between `: ping` keepalive comments on the event stream
# (stops reverse proxies dropping an idle stream during a long silent LLM call).
AGENT_ROOM_SSE_PING=15

# --- Cross-session memory (v0.5) — see SECURITY.md ---
# On: server persists curated MEMORY.md/USER.md + a SQLite/FTS5 transcript next
# to AGENT_ROOM_DB, and gives the developer a `memory` tool. Set 0 to disable
# (no persistence, NoOp). Persists task content across runs — keep the DB private.
AGENT_ROOM_MEMORY=1

# --- MCP (Model Context Protocol) tools — see SECURITY.md ---
# Optional. JSON object: server name → langchain-mcp-adapters connection config.
# Unset/empty (default) = no MCP tools, zero behavior change. Loaded once at
# startup; discovered tool names are granted to the developer and pass through
# the same AGENT_ROOM_TOOL_MODE permission filter as the built-in tools.
# Example (stdio filesystem server, requires `npx`):
# AGENT_ROOM_MCP_SERVERS={"fs":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"],"transport":"stdio"}}

# --- Per-task budget ceiling (v1.x §6.9-2) — see SECURITY.md ---
# All optional; unset (default) = unlimited, zero behavior change. Server-wide
# ceiling (applies the same to every task), not per-request. Exceeding any
# limit aborts the task with a `task_error(budget_exceeded=true)` SSE event.
# AGENT_ROOM_MAX_TOKENS=200000
# AGENT_ROOM_MAX_TOOL_CALLS=50
# AGENT_ROOM_MAX_COST_USD=5.0
# AGENT_ROOM_PRICE_PER_1K_INPUT=0.003
# AGENT_ROOM_PRICE_PER_1K_OUTPUT=0.015

# --- Content guardrail (v1.x §6.9-3) — see SECURITY.md ---
# off (default) = no scanning, zero behavior change. warn = scan + record to
# TaskState.events, never blocks. block = scan + reject at 4 checkpoints
# (input / tool_call / tool_response / output).
AGENT_ROOM_GUARDRAIL=off

# --- Hybrid semantic/vector memory recall (v1.x §6.9-4) — see SECURITY.md ---
# 0 (default) = transcript recall stays FTS5/LIKE-only (v0.5 behavior, zero
# change). 1 = also index every transcript message in a vector KNN index and
# fuse it with the lexical search via reciprocal rank fusion. Only takes
# effect when AGENT_ROOM_MEMORY=1.
AGENT_ROOM_MEMORY_VECTOR=0

# --- Vector recall backend (v1.x §6.15) — see SECURITY.md ---
# Only consulted when AGENT_ROOM_MEMORY_VECTOR=1.
# sqlite (default) = zero-dependency HashingEmbeddingBackend + sqlite-vec,
#   exactly the §6.9-4 behavior above.
# qdrant = real transformer embeddings (FastEmbedBackend) + QdrantVectorIndex.
#   Requires `pip install 'agent-room[vector]'`.
# AGENT_ROOM_VECTOR_BACKEND=sqlite

# Only used when AGENT_ROOM_VECTOR_BACKEND=qdrant. Default is a bilingual
# Chinese-English model (this project's real content shape) — see
# agent_room/memory/fastembed_backend.py for the full model-choice writeup.
# Lighter/faster alternative: BAAI/bge-small-zh-v1.5 (512-dim, Chinese-only).
# AGENT_ROOM_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh

# Qdrant embedded storage path (no server process to run — matches this
# project's zero-external-service default). Ignored if AGENT_ROOM_QDRANT_URL
# is set.
# AGENT_ROOM_QDRANT_PATH=./.agent_room_qdrant

# Opt-in: point at a real Qdrant server/cloud instance instead of embedded
# mode. Unset (default) = embedded. Sending vectors to this URL means task
# content leaves this process — operator's trust boundary, same as any
# configured MCP server (see SECURITY.md).
# AGENT_ROOM_QDRANT_URL=

# --- Physical per-tenant persistence isolation (v1.x §6.15) — see SECURITY.md ---
# Not an env var — set `tenant_id` in the POST /tasks(/stream) request body
# (default "default", unchanged single-tenant behavior). Each other tenant_id
# gets its own agent_room.db + curated/transcript files under
# <AGENT_ROOM_DB's dir>/tenants/<tenant_id>/. agent_room does not authenticate
# callers — tenant_id must come from a trusted layer in front of this server.
