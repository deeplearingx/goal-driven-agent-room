# Copy to .env.demo on the Linux VM. This file is consumed by both Compose
# files and is intentionally excluded from Git by the .env* rule below.

# DNS name that already has an A/AAAA record pointing to this VM.
CADDY_SITE=demo.example.com
ACME_EMAIL=you@example.com

# Basic Auth protects the public portfolio Demo. Generate the hash on the VM:
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'choose-a-long-password'
DEMO_BASIC_AUTH_USER=demo
# Keep the single quotes: Docker Compose must receive bcrypt's `$` characters
# literally instead of treating them as environment-variable substitutions.
DEMO_BASIC_AUTH_HASH='$2a$14$replace-with-caddy-bcrypt-hash'

# Generate with: openssl rand -hex 32
GATEWAY_API_KEY=replace-with-a-random-service-key
# Generate with: openssl rand -base64 32
# Used to encrypt provider-account records if optional Go workers are enabled.
GATEWAY_CONFIG_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
GATEWAY_CONFIG_ENCRYPTION_KEY_ID=demo-v1
POSTGRES_PASSWORD=replace-with-a-long-db-password
RABBITMQ_PASSWORD=replace-with-a-long-rabbitmq-password

# Pick one model-provider route; never put this key in VITE_* variables.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
