FROM golang:1.25.0-alpine AS build
WORKDIR /src
COPY gateway/go.mod gateway/go.sum* ./
RUN go mod download
COPY gateway/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/webhook-worker ./cmd/webhook-worker

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=65532:65532 /out/webhook-worker /webhook-worker
USER 65532:65532
ENTRYPOINT ["/webhook-worker"]
