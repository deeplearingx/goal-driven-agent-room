FROM golang:1.25.0-alpine AS build
WORKDIR /src
COPY gateway/go.mod gateway/go.sum* ./
RUN go mod download
COPY gateway/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/knowledge-worker ./cmd/knowledge-worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/knowledge-worker /knowledge-worker
USER nonroot:nonroot
ENTRYPOINT ["/knowledge-worker"]
