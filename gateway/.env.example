DATABASE_URL=postgresql://agent_room:local-agent-room@localhost:5432/agent_room
RABBITMQ_URL=amqp://agent_room:local-agent-room@localhost:5672/
GATEWAY_HTTP_ADDR=:8080
GATEWAY_ENV=development
# Required in production; leave blank only for trusted local development.
GATEWAY_API_KEY=
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
GATEWAY_RATE_PER_SECOND=20
GATEWAY_RATE_BURST=40
GATEWAY_DB_MAX_CONNECTIONS=30
GATEWAY_SSE_HEARTBEAT=15s
GATEWAY_WORKSPACE=../workspace
GATEWAY_DEFAULT_TENANT=default
# Leave false unless a verified reverse proxy supplies X-Tenant-ID.
GATEWAY_TRUST_TENANT_HEADER=false
# Configure OIDC in production instead of exposing GATEWAY_API_KEY to browsers.
# The verified token must carry the configured tenant and roles claims.
GATEWAY_OIDC_ISSUER=
GATEWAY_OIDC_AUDIENCE=
GATEWAY_OIDC_TENANT_CLAIM=tenant_id
GATEWAY_OIDC_ROLES_CLAIM=roles
# Base64 encoded 32-byte AES-256 key. Required before creating provider accounts.
# In production inject it from a KMS-backed secret, never commit it.
GATEWAY_CONFIG_ENCRYPTION_KEY=
GATEWAY_CONFIG_ENCRYPTION_KEY_ID=local-v1
# Keep false until the Go Eino worker is deployed and healthy.
GATEWAY_ENABLE_EINO_RUNTIME=false
# The migration service sets these; do not enable in every Gateway replica.
GATEWAY_AUTO_MIGRATE=false
GATEWAY_MIGRATE_ONLY=false
# Set 0 to disable expiry. LangGraph checkpoint retention is managed separately.
GATEWAY_RETENTION=720h
GATEWAY_CLEANUP_INTERVAL=1h
AGENT_ROOM_WORKER_CONCURRENCY=4
AGENT_ROOM_WORKER_LEASE_SECONDS=600
